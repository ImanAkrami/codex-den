Screen { background: $background; color: $foreground; }
#shell { padding: 1 3; }
#masthead { height: 3; align-vertical: middle; border-bottom: solid $primary; }
#brand { width: 24; color: $primary; text-style: bold; }
#tagline { width: 1fr; color: $text-muted; }
#edition { width: 17; text-align: right; color: $text-muted; }
#summary { height: 3; padding: 1 0; color: $text-muted; }
#toolbar { height: 4; margin-bottom: 1; }
#toolbar Button { margin-right: 1; min-width: 14; }
#actions { width: 1fr; min-width: 18; }
#dashboard { height: 1fr; }
#workspace-pane { width: 2fr; min-width: 24; padding-right: 2; }
#detail-pane { width: 3fr; border-left: solid $panel; padding-left: 3; }
.section-title { color: $text-muted; text-style: bold; height: 2; }
#search { margin-bottom: 1; }
#workspace-filter { margin-bottom: 1; }
#workspaces { height: 1fr; background: $background; border: none; }
/* Textual 6 counts content lines without vertical component padding. Keep
   options visible in Select overlays and SelectionList as well as the dashboard. */
OptionList > .option-list--option { padding: 0 1; }
OptionList > .option-list--option-highlighted { background: $panel; color: $primary; text-style: bold; }
#details { height: 1fr; overflow-y: auto; }
#workspace-actions { height: 3; margin-top: 1; }
#workspace-actions Button { margin-right: 1; }
#statusline { height: 2; padding-top: 1; color: $text-muted; }
Footer { background: $surface; }
Button { border: none; background: $panel; }
Button.-primary { background: $primary; color: $background; text-style: bold; }
Button:focus { text-style: bold underline; }
Button:hover { background-tint: $foreground 8%; }
Button { transition: background-tint 120ms; }
#launch-progress { height: 1; display: none; }
Input, Select { border: tall $panel; }
Input:focus { border: tall $primary; }
ModalScreen { align: center middle; background: $background 75%; }
.dialog { width: 84; max-width: 95%; max-height: 95%; height: auto; padding: 1 2; background: $surface; border: round $primary; }
.dialog-title { text-style: bold; color: $primary; height: 2; }
.muted { color: $text-muted; height: auto; margin-bottom: 1; }
.error { color: $error; height: auto; margin-top: 1; }
.buttons { height: 3; align-horizontal: right; margin-top: 1; }
.buttons Button { margin-left: 1; }
.form-fields { height: 1fr; min-height: 0; }
.form-fields Label { margin-top: 1; }
.form-dialog { height: 90%; }
.review { height: 85%; }
#review-content { height: 1fr; border: none; background: $background; }
.settings-dialog { height: 90%; }
.settings-content, .picker-content { height: 1fr; min-height: 0; }
#settings-table { height: 12; margin-bottom: 1; }
#import-files, #discovered { height: 8; margin: 1 0; }
.import-dialog { height: 90%; }
.wizard-dialog { height: 90%; }
.wizard-content { height: 1fr; }
.wizard-content > Vertical { height: auto; }
.wizard-content Input, .wizard-content Select { margin-bottom: 1; }
#setup-summary { height: auto; padding: 1 0; }
Screen.narrow #shell { padding: 0 1; }
Screen.narrow #tagline, Screen.narrow #edition { display: none; }
Screen.narrow #toolbar { height: 8; layout: grid; grid-size: 2; grid-gutter: 0 1; }
Screen.narrow #toolbar Button, Screen.narrow #actions { width: 1fr; }
Screen.narrow #dashboard { layout: vertical; }
Screen.narrow #workspace-pane { width: 100%; height: 1fr; padding-right: 0; }
Screen.narrow #detail-pane { width: 100%; height: 1fr; border-left: none; border-top: solid $panel; padding: 1 0 0 0; }
Screen.narrow #details { min-height: 2; }
Screen.narrow #statusline { display: none; }
/* Compact terminals retain actual list rows and shared context. */
Select { border: none; }
Screen.narrow #masthead { height: 2; }
Screen.narrow #summary { height: 2; padding: 0; }
Screen.narrow #toolbar { height: 6; margin-bottom: 0; }
Screen.narrow #workspace-pane { height: 1fr; min-height: 0; }
Screen.narrow #detail-pane { height: 6; min-height: 6; padding: 0; }
Screen.narrow #workspace-filter { margin-bottom: 0; }
Screen.narrow .section-title { height: 1; }
Screen.narrow #search { margin-bottom: 0; }
Screen.narrow #workspace-actions { height: 1; margin-top: 0; }
